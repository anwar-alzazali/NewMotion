        "teks": "Namun Nabi Musa tidak goyah sedikit pun. Di hadapan kepanikan massal, beliau menegaskan keyakinan mutlaknya kepada pertolongan Allah.",
        "peran": [
          "Nabi Musa",
          "Bani Israil"
        ],
        "tokoh_ids": [
          "tokoh-29cdcbb5b29b",
          "tokoh-9104e15831d4"
        ],
        "dialog": [
          {
            "pembicara": "Nabi Musa",
            "ucapan": "Sekali-kali tidak! Sesungguhnya Tuhanku bersamaku, Dia akan memberi petunjuk kepadaku.",
            "penjawab": "Bani Israil"
          }
        ],
        "benda_ids": []
      },
      {
        "id": "beat-005",
        "nama": "adegan_5",
        "teks": "Allah lalu memerintahkan Nabi Musa memukulkan tongkatnya ke permukaan air, hingga laut terbelah dan setiap belahannya menjulang laksana gunung yang amat besar.",
        "peran": [
          "Nabi Musa",
          "Bani Israil"
        ],
        "tokoh_ids": [
          "tokoh-29cdcbb5b29b",
          "tokoh-9104e15831d4"
        ],
        "dialog": [],
        "benda_ids": []
      },
      {
        "id": "beat-006",
        "nama": "adegan_6",
        "teks": "Nabi Musa dan seluruh pengikutnya menyeberangi dasar laut dengan selamat, sebelum akhirnya Firaun dan seluruh pasukannya masuk mengejar ke tengah dinding air itu.",
        "peran": [
          "Nabi Musa",
          "Bani Israil",
          "Firaun",
          "tentara Firaun"
        ],
        "tokoh_ids": [
          "tokoh-29cdcbb5b29b",
          "tokoh-9104e15831d4",
          "tokoh-d3a2d4d3985b",
          "tokoh-7da4972b2ec2"
        ],
        "dialog": [],
        "benda_ids": []
      },
      {
        "id": "beat-007",
        "nama": "adegan_7",
        "teks": "Ketika hampir tenggelam, Firaun berkata bahwa ia percaya tidak ada tuhan selain yang dipercayai Bani Israil. Allah berfirman apakah sekarang baru beriman padahal sebelumnya durhaka.",
        "peran": [
          "Firaun"
        ],
        "tokoh_ids": [
          "tokoh-d3a2d4d3985b"
        ],
        "dialog": [
          {
            "pembicara": "Firaun",
            "ucapan": "Aku percaya bahwa tidak ada tuhan melainkan Tuhan yang dipercayai oleh Bani Israil, dan aku termasuk orang-orang yang berserah diri.",
            "penjawab": null
          }
        ],
        "benda_ids": []
      },
      {
        "id": "beat-008",
        "nama": "adegan_8",
        "teks": "Allah kemudian menyelamatkan badan Firaun agar menjadi pelajaran bagi orang-orang yang datang sesudahnya, termasuk kamu.",
        "peran": [
          "Firaun"
        ],
        "tokoh_ids": [
          "tokoh-d3a2d4d3985b"
        ],
        "dialog": [],
        "benda_ids": []
      },
      {
        "id": "beat-009",
        "nama": "adegan_9",
        "teks": "Sebesar apa pun ancaman yang mengepung hidupmu, jangan pernah kehilangan sandaran kepada Allah, sebab pintu pertolongan sering kali terbuka di saat manusia merasa segalanya telah berakhir.",
