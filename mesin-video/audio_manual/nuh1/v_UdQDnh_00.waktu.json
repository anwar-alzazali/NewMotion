 "subtitle": [
  [
   0.0,
   1.84,
   "Saat banjir besar Nabi Nuh,"
  ],
  [
   1.88,
   3.4,
   "kamu ada di kapal itu."
  ],
  [
   3.6,
   4.72,
   "Itu kata Al-Qur'an."
  ],
  [
   5.12,
   5.88,
   "Maksudnya,"
  ],
  [
   6.0,
   6.88,
   "nenek moyangmu."
  ],
  [
   7.36,
   8.4,
   "Dan penumpangnya,"
  ],
  [
   8.56,
   10.04,
   "hanya segelintir orang."
  ],
  [
   10.32,
   12.4,
   "Sembilan ratus lima puluh tahun,"
  ],
  [
   12.44,
   14.56,
   "Nabi Nuh tinggal di tengah kaumnya,"
  ],
  [
   14.6,
   15.6,
   "mengajak mereka."
  ],
  [
   16.08,
   16.8,
   "Yang beriman,"
  ],
  [
   17.04,
   17.84,
   "hanya sedikit."
  ],
  [
   18.4,
   19.68,
   "Beliau membuat kapal."
  ],
  [
   20.08,
   21.92,
   "Setiap pemuka kaumnya lewat,"
  ],
  [
   22.04,
   22.88,
   "mereka mengejek."
  ],
  [
   23.36,
   25.44,
   "Lalu pintu-pintu langit dibuka,"
  ],
  [
   25.48,
   26.96,
   "dengan air yang tercurah."
  ],
  [
   27.36,
   29.52,
   "Dan bumi memancarkan mata air."
  ],
  [
   29.76,
   31.92,
   "Sepasang dari tiap jenis hewan naik,"
  ],
  [
   32.04,
   33.52,
   "bersama mereka yang beriman."
  ],
  [
   33.92,
   35.2,
   "Kapal itu berlayar,"
  ],
  [
   35.24,
   36.96,
   "di tengah ombak laksana gunung."
  ],
  [
   37.44,
   40.0,
   "Dan yang paling menyesakkan… anak beliau"
  ],
  [
   40.08,
   40.72,
   "sendiri,"
  ],
  [
   40.8,
   41.52,
   "menolak naik."
  ],
  [
   41.92,
   42.4,
   "Katanya:"
  ],
  [
   42.8,
   44.32,
   "aku akan berlindung ke gunung."
  ],
  [
   44.8,
   46.56,
   "Ombak memisahkan keduanya."
  ],
  [
   47.04,
   47.68,
   "Hari itu,"
  ],
  [
   47.92,
   49.92,
   "yang menyelamatkan bukan keturunan."
  ],
  [
   50.24,
   51.2,
   "Tapi mau naik,"
  ],
  [
   51.36,
   52.0,
   "atau tidak."
  ],
  [
   52.4,
   53.92,
   "Kirim ke orang yang sedang merasa"
  ],
  [
   54.0,
   54.72,
   "sendirian,"
  ],
  [
   54.76,
   55.96,
   "di jalan yang benar."
  ],
  [
   56.16,
   57.84,
   "Kalau kamu hidup saat itu,"
  ],
  [
   57.88,
   59.44,
   "yakin kamu ikut naik?"
  ]
