  ],
  [
   23.76,
   24.72,
   "Begitu terus."
  ],
  [
   24.88,
   26.12,
   "Hari demi hari."
  ],
  [
   26.32,
   28.56,
   "Sampai tiba waktu yang Allah tetapkan."
  ],
  [
   28.88,
   30.8,
   "Hari itu pemimpin mereka berkata:"
  ],
  [
   31.2,
   33.72,
