{
  "judul": "Doa Taubat Pertama",
  "genre": "kisah_islami",
  "konteks_konten": "islami",
  "adegan": [
    {
      "nama": "adegan_01",
      "teks": "Pernah merasa dosamu terlalu banyak…"
    },
    {
      "nama": "adegan_02",
      "teks": "sampai malu untuk berdoa?"
    },
    {
      "nama": "adegan_03",
      "teks": "Manusia pertama pun pernah berbuat"
    },
    {
      "nama": "adegan_04",
      "teks": "salah."
    },
    {
      "nama": "adegan_05",
      "teks": "Nabi Adam dan Hawa tidak"
    },
    {
      "nama": "adegan_06",
      "teks": "mencari alasan."
    },
    {
      "nama": "adegan_07",
      "teks": "Mereka mengakuinya… lalu berdoa."
    },
    {
      "nama": "adegan_08",
      "teks": "Ya Tuhan kami,"
    },
    {
      "nama": "adegan_09",
      "teks": "kami telah menzalimi diri kami"
    },
    {
      "nama": "adegan_10",
      "teks": "sendiri."
    },
    {
      "nama": "adegan_11",
      "teks": "Jika Engkau tidak mengampuni dan"
    },
    {
      "nama": "adegan_12",
      "teks": "merahmati kami,"
    },
    {
      "nama": "adegan_13",
      "teks": "niscaya kami termasuk orang-orang yang"
    },
    {
      "nama": "adegan_14",
      "teks": "rugi."
    },
    {
      "nama": "adegan_15",
      "teks": "Dan Allah menerima taubatnya."
    },
    {
      "nama": "adegan_16",
      "teks": "Sebesar apa pun dosamu… pintu"
    },
    {
      "nama": "adegan_17",
      "teks": "itu masih terbuka."
    },
    {
      "nama": "adegan_18",
      "teks": "Ucapkan doa ini,"
    },
    {
      "nama": "adegan_19",
      "teks": "malam ini."
    }
  ]
}