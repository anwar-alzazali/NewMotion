s": [], "dialog": [], "benda_ids": []}, {"id": "beat-003", "nama": "adegan_3", "teks": "Aisyah sampai bertanya hal yang mungkin terpikir olehmu sekarang. Ya Rasulullah, apakah laki-laki dan perempuan saling melihat? Jawaban beliau… urusan hari itu terlalu dahsyat untuk itu.", "peran": [], "tokoh_ids": [], "dialog": [], "benda_ids": []}, {"id": "beat-004", "nama": "adegan_4", "teks": "Kamu menoleh. Seluruh manusia, dari yang pertama sampai yang terakhir. Bumi putih kemerahan, rata, tanpa satu pun tanda. Tidak ada jalan pulang.", "peran": [], "tokoh_ids": [], "dialog": [], "benda_ids": []}, {"id": "beat-005", "nama": "adegan_5", "teks": "Lalu terjadi sesuatu yang mengubah semuanya. Matahari… didekatkan. Hanya sejauh satu mil.", "peran": [], "tokoh_ids": [], "dialog": [], "benda_ids": []}, {"id": "beat-006", "nama": "adegan_6", "teks": "Manusia tenggelam dalam keringatnya, sesuai amalnya. Ada yang sampai mata kaki. Ada yang sampai lutut. Ada yang sampai pinggang. Dan ada… yang keringatnya sampai ke mulut.", "peran": [], "tokoh_ids": [], "dialog": [], "benda_ids": []}, {"id": "beat-007", "nama": "adegan_7", "teks": "Keringat itu bahkan meresap ke dalam tanah, sedalam tujuh puluh hasta.", "peran": [], "tokoh_ids": [], "dialog": [], "benda_ids": []}, {"id": "beat-008", "nama": "adegan_8", "teks": "Tapi yang paling menyakitkan… bukan panasnya. Hari itu, seseorang lari dari saudaranya. Dari ibu dan ayahnya. Dari istri dan anak-anaknya.", "peran": [], "tokoh_ids": [], "dialog": [], "benda_ids": []}, {"id": "beat-009", "nama": "adegan_9", "teks": "Kamu menunduk. Keringatmu… sampai mana?", "peran": [], "tokoh_ids": [], "dialog": [], "benda_ids": []}, {"id": "beat-010", "nama": "adegan_10", "teks": "Tapi ternyata, ada tujuh golongan yang justru mendapat naungan hari itu. Dan salah satunya… bisa kamu kerjakan mulai malam ini. Kita bahas di bagian dua.", "peran": [], "tokoh_ids": [], "dialog": [], "benda_ids": []}, {"id": "beat-011", "nama": "adegan_11", "teks": "Kalau ada yang keliru, koreksi kami, lengkap dengan sumbernya. Kirim ke orang yang ingin kamu ajak berteduh bersama.", "peran": [], "tokoh_ids": [], "dialog": [], "benda_ids": []}], "diagnostik": []}, "rencana_blocking": {"versi": 1, "tahap": "kontrak_semantik", "catatan": "Belum berisi koordinat, lintasan, pose, atau gerak. Pengarah visual harus memetakannya ke boneka dan benda renderer.", "peristiwa": [], "transisi_keadaan": [], "keadaan_akhir": {}, "shot": [{"indeks": 0, "beat_id": "beat-001", "peristiwa_ids": []}, {"indeks": 1, "beat_id": "beat-002", "peristiwa_ids": []}, {"indeks": 2, "beat_id": "beat-003", "peristiwa_ids": []}, {"indeks": 3, "beat_id": "beat-003", "peristiwa_ids": []}, {"indeks": 4, "beat_id": "beat-004", "peristiwa_ids": []}, {"indeks": 5, "beat_id": "beat-004", "peristiwa_ids": []}, {"indeks": 6, "beat_id": "beat-005", "peristiwa_ids": []}, {"indeks": 7, "beat_id": "beat-006", "peristiwa_ids": []}, {"indeks": 8, "beat_id": "beat-006", "peristiwa_ids": []}, {"indeks": 9, "beat_id": "beat-007", "peristiwa_ids": []}, {"indeks": 10, "beat_id": "beat-008", "peristiwa_ids": []}, {"indeks": 11, "beat_id": "beat-008", "peristiwa_ids": []}, {"indeks": 12, "beat_id": "beat-009", "peristiwa_ids": []}, {"indeks": 13, "beat_id": "beat-010", "peristiwa_ids": []}, {"indeks": 14, "beat_id": "beat-010", "peristiwa_ids": []}, {"indeks": 15, "beat_id": "beat-011", "peristiwa_ids": []}, {"indeks": 16, "beat_id": "beat-011", "peristiwa_ids": []}], "diagnostik": []}, "rencana_visual_tokoh": {"status": "belum_didukung_paket", "shot": [], "diagnostik": [{"kode": "paket_belum_menyediakan_pengarah_tokoh_visual", "pesan": "Roster tokoh dipertahankan sebagai data cerita; paket genre belum mengizinkan pemetaan ke visual renderer."}]}, "genre": "kisah_islami", "konteks_konten": "islami"}
